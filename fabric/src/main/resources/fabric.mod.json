{
  "schemaVersion": 1,
  "id": "ctm_reborn",
  "provides": [
    "athena"
  ],
  "version": "${version}",
  "name": "CTM Reborn",
  "description": "Crossplatform Baked Model Loader. A fork of Athena by ThatGravyBoat / Terrarium Earth, maintained to keep connected textures working on current Minecraft versions for Chisel Reborn. It is intended to be deprecated once Athena itself updates.",
  "authors": [
    "ThatGravyBoat"
  ],
  "contributors": [
    "matthewperiut"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/athena-ctm",
    "repo": "https://github.com/matthewperiut/ctm-reborn",
    "issues": "https://github.com/matthewperiut/ctm-reborn/issues"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "mixins": [
      "athena.mixins.json"
  ],
  "entrypoints": {
    "client": [
      "earth.terrarium.athena.impl.client.DefaultModels::init",
      "earth.terrarium.athena.fabric.client.AthenaFabricClient"
    ]
  },
  "custom": {
    "modmenu": {
      "badges": [
        "library"
      ]
    }
  },
  "depends": {
    "fabric-api": "*",
    "minecraft": "~26.2"
  }
}
